:root {
    --primary-color: #2c3e50;
    --secondary-color: #18bc9c;
    --danger-color: #e74c3c;
    --bg-color: #ecf0f1;
    --card-bg: #ffffff;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: var(--bg-color);
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 20px;
}

.card {
    background: var(--card-bg);
    padding: 30px;
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    width: 100%;
    max-width: 500px;
    transition: max-width 0.3s ease;
}

#app-container.card {
    max-width: 800px; /* Tela do balanço é maior */
}

h2 {
    color: var(--primary-color);
    margin-bottom: 20px;
}

h3 {
    color: var(--primary-color);
    margin-bottom: 15px;
    border-bottom: 2px solid var(--bg-color);
    padding-bottom: 5px;
}

.input-group {
    margin-bottom: 15px;
}

label {
    display: block;
    margin-bottom: 5px;
    font-weight: 600;
    color: #555;
    font-size: 14px;
}

input {
    width: 100%;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 16px;
}

.btn {
    width: 100%;
    padding: 12px;
    background-color: var(--primary-color);
    color: white;
    border: none;
    border-radius: 4px;
    font-size: 16px;
    cursor: pointer;
    font-weight: bold;
}

.btn:hover {
    background-color: #1a252f;
}

.btn-secondary {
    padding: 8px 15px;
    background-color: var(--danger-color);
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
}

.header-app {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.grid-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
}

@media (max-width: 600px) {
    .grid-form {
        grid-template-columns: 1fr;
    }
}

.hidden {
    display: none !important;
}

.error-msg {
    color: var(--danger-color);
    margin-top: 10px;
    font-size: 14px;
    text-align: center;
}

.resultado {
    margin-top: 25px;
    padding: 20px;
    background-color: #f8f9fa;
    border-radius: 6px;
    border-left: 5px solid var(--primary-color);
}

.tabela-resumo p {
    margin-bottom: 10px;
    font-size: 16px;
}

.status-box {
    margin-top: 15px;
    padding: 10px;
    border-radius: 4px;
    text-align: center;
    font-weight: bold;
}

.sucesso { background-color: #d4edda; color: #155724; }
.erro { background-color: #f8d7da; color: #721c24; }
